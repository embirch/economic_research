{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gender-ai/results.schema.json",
  "title": "New-study result record",
  "description": "For new studies; existing analyses keep their documented schemas. No requirement for inferential quantities when unavailable.",
  "type": "object",
  "required": [
    "study_id",
    "generated",
    "results"
  ],
  "properties": {
    "study_id": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "value",
          "unit",
          "population",
          "source_ids",
          "calculation",
          "uncertainty"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "population": {
            "type": "string"
          },
          "denominator": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "calculation": {
            "type": "string"
          },
          "uncertainty": {
            "type": "object",
            "required": [
              "status",
              "explanation"
            ],
            "properties": {
              "status": {
                "enum": [
                  "estimated",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "interval": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

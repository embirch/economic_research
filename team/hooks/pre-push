#!/bin/sh
# Local safeguard; remote protection is a separate GitHub setting.
while read -r local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "Direct pushes to main are blocked locally. Push a work branch and review its pull request." >&2
        exit 1
    fi
done
exit 0
